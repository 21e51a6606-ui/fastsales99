# systemd unit - copy to /etc/systemd/system/fastsales99.service
# then: sudo systemctl daemon-reload && sudo systemctl enable --now fastsales99
[Unit]
Description=FastSales99 admin portal (Gunicorn)
After=network.target

[Service]
User=fastsales
Group=fastsales
WorkingDirectory=/opt/fastsales99/backend
EnvironmentFile=/etc/fastsales99.env
ExecStart=/opt/fastsales99/backend/.venv/bin/gunicorn --config /opt/fastsales99/deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
