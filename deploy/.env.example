# Copy to /etc/fastsales99.env on the server (chmod 600) and fill in real values.

# REQUIRED: long random string. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database. SQLite is fine for a single small server.
# For Postgres use: postgresql+psycopg://user:pass@host:5432/fastsales (and pip install psycopg[binary])
DATABASE_URL=sqlite:////opt/fastsales99/backend/instance/fastsales.db

# First-start bootstrap: creates this Super Admin if the users table is empty.
# Remove these lines after the first successful login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-too

FLASK_DEBUG=0
